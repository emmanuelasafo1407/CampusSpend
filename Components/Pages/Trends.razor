@page "/trends"
@rendermode InteractiveServer
@using CampusSpend.Models
@using CampusSpend.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Spending Trends & Academic Portfolio — CampusSpend</PageTitle>

<div class="container-fluid px-4 py-4 min-vh-100 bg-light">
    
    <!-- Top Header & Print Export Button -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Analytics & Academic Capital ROI</h2>
            <small class="text-muted">Analyze expenditure velocity, academic return on investment, and generate official portfolio audits.</small>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button class="btn btn-outline-dark btn-sm shadow-sm" @onclick="TriggerPrintReport">
                <i class="bi bi-printer-fill me-1"></i> Print / Export Semester Audit
            </button>
        </div>
    </div>

    <!-- FEATURE 2: Academic ROI & Capital-to-Grade Correlator -->
    <div class="card stat-card shadow-sm border-0 mb-4 p-4 bg-white border-start border-4 border-warning">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="badge bg-warning text-dark px-3 py-1 mb-1">
                    <i class="bi bi-mortarboard-fill me-1"></i> Academic Capital Return (ROI)
                </span>
                <h5 class="fw-bold text-dark mb-0">Investment in Academic Supplies vs. Projected Performance</h5>
            </div>
            <div class="text-end">
                <small class="text-muted d-block">Target Semester Standing</small>
                <span class="badge bg-success fs-6">@AcademicStanding</span>
            </div>
        </div>

        <div class="row g-3 text-center">
            <div class="col-sm-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase d-block fw-semibold" style="font-size: 0.72rem;">Academic Capital Invested</small>
                    <div class="fs-4 fw-bold text-warning mt-1">GHS @AcademicSpend.ToString("N2")</div>
                    <small class="text-muted">Handouts, slides & printing</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase d-block fw-semibold" style="font-size: 0.72rem;">Cost Per Credit Hour</small>
                    <div class="fs-4 fw-bold text-primary mt-1">GHS @CostPerCreditHour.ToString("F2")</div>
                    <small class="text-muted">Across @TotalCredits registered credits</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase d-block fw-semibold" style="font-size: 0.72rem;">Cost Per Mastered Slide Deck</small>
                    <div class="fs-4 fw-bold text-success mt-1">GHS @CostPerMasteredSlide.ToString("F2")</div>
                    <small class="text-muted">@TotalMasteredSlides / @TotalSlides slides mastered</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase d-block fw-semibold" style="font-size: 0.72rem;">Projected GPA Return</small>
                    <div class="fs-4 fw-bold text-dark mt-1">@ProjectedGPA.ToString("F2") / 4.00</div>
                    <small class="text-muted">GCTU Scheme Alignment</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Graphical Breakdown: SVG Pie Chart & Category Table -->
    <div class="row g-4 mb-4">
        <!-- SVG Pie Chart -->
        <div class="col-lg-5">
            <div class="card stat-card shadow-sm border-0 p-4 bg-white h-100">
                <h6 class="fw-bold text-dark mb-3">Expenditure Distribution</h6>
                @if (TotalSpent == 0)
                {
                    <div class="p-5 text-center text-muted small">No expenses logged to chart yet.</div>
                }
                else
                {
                    <div class="d-flex justify-content-center align-items-center mb-3">
                        <svg width="200" height="200" viewBox="-1 -1 2 2" style="transform: rotate(-90deg);">
                            @{
                                double accumulatedAngle = 0;
                                foreach (var cat in CategoryBreakdowns)
                                {
                                    if (cat.Amount == 0) continue;
                                    double portion = (double)(cat.Amount / TotalSpent);
                                    double startAngle = accumulatedAngle;
                                    double endAngle = accumulatedAngle + portion * 2 * Math.PI;
                                    accumulatedAngle = endAngle;

                                    double x1 = Math.Cos(startAngle);
                                    double y1 = Math.Sin(startAngle);
                                    double x2 = Math.Cos(endAngle);
                                    double y2 = Math.Sin(endAngle);
                                    int largeArc = portion > 0.5 ? 1 : 0;
                                    string pathData = $"M 0 0 L {x1:F4} {y1:F4} A 1 1 0 {largeArc} 1 {x2:F4} {y2:F4} Z";

                                    <path d="@pathData" fill="@cat.ColorHex" />
                                }
                            }
                        </svg>
                    </div>

                    <div class="list-group list-group-flush small">
                        @foreach (var cat in CategoryBreakdowns)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-1 border-0">
                                <span><i class="bi bi-circle-fill me-2" style="color: @cat.ColorHex; font-size: 0.65rem;"></i>@cat.Category</span>
                                <span class="fw-bold">GHS @cat.Amount.ToString("N2") <small class="text-muted">(@(TotalSpent > 0 ? (cat.Amount / TotalSpent * 100).ToString("F0") : "0")%)</small></span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- 7-Day Velocity Flow & Category Outflow Table -->
        <div class="col-lg-7">
            <div class="card stat-card shadow-sm border-0 p-4 bg-white h-100">
                <h6 class="fw-bold text-dark mb-3">Detailed Category Breakdown & Audit</h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Category</th>
                                <th>Entries</th>
                                <th>Share</th>
                                <th class="text-end">Total (GHS)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in CategoryBreakdowns)
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-square-fill me-2" style="color: @cat.ColorHex; font-size: 0.75rem;"></i>
                                        <strong>@cat.Category</strong>
                                    </td>
                                    <td class="text-muted small">@cat.EntryCount entries</td>
                                    <td>
                                        <div class="progress rounded-pill" style="height: 6px; width: 80px;">
                                            <div class="progress-bar rounded-pill" style="width: @(TotalSpent > 0 ? (cat.Amount / TotalSpent * 100) : 0)%; background-color: @cat.ColorHex;"></div>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold">GHS @cat.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- FEATURE 4: Printable Semester Executive Audit Section (Visible on Screen & Cleanly Formatted for Print) -->
    <div class="card stat-card shadow-sm border-0 p-4 bg-white mt-4" id="printableReportSection">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-0">CampusSpend Semester Executive Audit</h4>
                <small class="text-muted">Consolidated Financial & Academic Standing Record · Generated on @DateTime.Now.ToString("dd MMMM yyyy")</small>
            </div>
            <span class="badge bg-dark px-3 py-2">Official Student Hub Record</span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6 border-end">
                <h6 class="fw-bold text-primary mb-2"><i class="bi bi-wallet2 me-1"></i> Financial Health Audit</h6>
                <ul class="list-unstyled small mb-0">
                    <li class="d-flex justify-content-between py-1"><span>Total Semester Expenditure:</span> <strong>GHS @TotalSpent.ToString("N2")</strong></li>
                    <li class="d-flex justify-content-between py-1"><span>Budget Cap:</span> <strong>GHS @(activeBudget?.TargetAmount.ToString("N2") ?? "0.00")</strong></li>
                    <li class="d-flex justify-content-between py-1"><span>Total Capital Saved to Goals:</span> <strong>GHS @goals.Where(g => g.GoalType == "Financial").Sum(g => g.CurrentSaved).ToString("N2")</strong></li>
                    <li class="d-flex justify-content-between py-1"><span>Hall of Achievements Unlocked:</span> <strong>@goals.Count(g => g.IsArchived) Goals</strong></li>
                </ul>
            </div>
            <div class="col-md-6 ps-md-4">
                <h6 class="fw-bold text-success mb-2"><i class="bi bi-mortarboard-fill me-1"></i> Academic Progress Audit</h6>
                <ul class="list-unstyled small mb-0">
                    <li class="d-flex justify-content-between py-1"><span>Registered Courses:</span> <strong>@courses.Count Courses (@TotalCredits Credits)</strong></li>
                    <li class="d-flex justify-content-between py-1"><span>Projected Semester GPA:</span> <strong class="text-success">@ProjectedGPA.ToString("F2") (@AcademicStanding)</strong></li>
                    <li class="d-flex justify-content-between py-1"><span>Overall Slide Deck Coverage:</span> <strong>@TotalMasteredSlides / @TotalSlides Slides (@(TotalSlides > 0 ? (TotalMasteredSlides * 100 / TotalSlides) : 0)%)</strong></li>
                    <li class="d-flex justify-content-between py-1"><span>Engineering Projects Underway:</span> <strong>@goals.Count(g => g.GoalType == "PersonalProject" && !g.IsArchived) Active</strong></li>
                </ul>
            </div>
        </div>

        <div class="alert alert-light border small text-muted mb-0">
            <i class="bi bi-check-circle-fill text-success me-1"></i>
            This audit report certifies that all expense records, slide completions, and milestone logs are authenticated within the student's local encrypted SQLite database.
        </div>
    </div>
</div>

@code {
    private List<Expense> expenses = new();
    private List<SemesterCourse> courses = new();
    private List<SavingsGoal> goals = new();
    private BudgetSetting? activeBudget;

    private decimal TotalSpent => expenses.Sum(e => e.Amount);
    private decimal AcademicSpend => expenses.Where(e => e.Category == "Academics").Sum(e => e.Amount);

    private int TotalCredits => courses.Sum(c => c.CreditHours);
    private int TotalSlides => courses.Sum(c => c.TotalSlides);
    private int TotalMasteredSlides => courses.Sum(c => c.CoveredSlides);

    private decimal CostPerCreditHour => TotalCredits > 0 ? AcademicSpend / TotalCredits : 0;
    private decimal CostPerMasteredSlide => TotalMasteredSlides > 0 ? AcademicSpend / TotalMasteredSlides : 0;

    private double ProjectedGPA =>
        TotalCredits > 0
            ? courses.Sum(c => c.GradePoint * c.CreditHours) / TotalCredits
            : 0.0;

    private string AcademicStanding => ProjectedGPA switch
    {
        >= 3.60 => "First Class Honours 🎓",
        >= 3.00 => "Second Class Upper",
        >= 2.50 => "Second Class Lower",
        >= 2.00 => "Third Class",
        > 0.00 => "Pass",
        _ => "No Grades Set"
    };

    private record CategoryData(string Category, decimal Amount, int EntryCount, string ColorHex);

    private List<CategoryData> CategoryBreakdowns => new()
    {
        new("Food", expenses.Where(e => e.Category == "Food").Sum(e => e.Amount), expenses.Count(e => e.Category == "Food"), "#10b981"),
        new("Academics", expenses.Where(e => e.Category == "Academics").Sum(e => e.Amount), expenses.Count(e => e.Category == "Academics"), "#f59e0b"),
        new("Transport", expenses.Where(e => e.Category == "Transport").Sum(e => e.Amount), expenses.Count(e => e.Category == "Transport"), "#3b82f6"),
        new("Data/Airtime", expenses.Where(e => e.Category == "Data/Airtime").Sum(e => e.Amount), expenses.Count(e => e.Category == "Data/Airtime"), "#8b5cf6"),
        new("Utilities", expenses.Where(e => e.Category == "Utilities").Sum(e => e.Amount), expenses.Count(e => e.Category == "Utilities"), "#ec4899"),
        new("Lifestyle", expenses.Where(e => e.Category == "Lifestyle").Sum(e => e.Amount), expenses.Count(e => e.Category == "Lifestyle"), "#64748b")
    };

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        expenses = await db.Expenses.ToListAsync();
        courses = await db.SemesterCourses.ToListAsync();
        goals = await db.SavingsGoals.ToListAsync();
        activeBudget = await db.BudgetSettings.FirstOrDefaultAsync();
    }

    private async Task TriggerPrintReport()
    {
        await JS.InvokeVoidAsync("printPage");
    }
}