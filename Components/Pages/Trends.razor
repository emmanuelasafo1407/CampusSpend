@page "/trends"
@rendermode InteractiveServer
@using CampusSpend.Models
@using CampusSpend.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Analytics & Trends — CampusSpend</PageTitle>

<div class="container-fluid px-4 pt-5 pb-5 min-vh-100 bg-light">
    <div class="mb-4 mt-3">
        <h2 class="fw-bold text-dark mb-0">Spending Velocity & Categorical Analysis</h2>
        <small class="text-muted">Check Your Spending Patterns Over Time</small>
    </div>

    <!-- Velocity Indicator Card -->
    <div class="card stat-card shadow-sm border-0 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <small class="text-uppercase text-muted fw-bold">Spending Rate Indicator</small>
                <h3 class="fw-bold @(IsSpendingTrendingUp ? "text-danger" : "text-success") mb-0">
                    @(IsSpendingTrendingUp ? "Warning: Spending Surge Detected" : "Optimal Spending Velocity")
                </h3>
                <p class="text-muted small mb-0 mt-1">
                    @(IsSpendingTrendingUp 
                        ? "Recent 3-day expenses significantly exceed prior average. Pacing alert active." 
                        : "Daily expenses are controlled and below weekly thresholds.")
                </p>
            </div>
            <div class="badge @(IsSpendingTrendingUp ? "bg-danger" : "bg-success") p-3 fs-6 rounded-circle">
                <i class="bi @(IsSpendingTrendingUp ? "bi-graph-up-arrow" : "bi-graph-down-arrow")"></i>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- SVG Pie Chart -->
        <div class="col-lg-6">
            <div class="card stat-card shadow-sm border-0 p-4 bg-white h-100">
                <h6 class="fw-bold mb-3">Category Expenditure Share (Pie Chart)</h6>
                @if (TotalSpent == 0)
                {
                    <div class="text-center py-5 text-muted">No expenses recorded to build chart.</div>
                }
                else
                {
                    <div class="row align-items-center">
                        <div class="col-sm-6 text-center">
                            <svg viewBox="-1.1 -1.1 2.2 2.2" style="transform: rotate(-90deg); max-width: 220px; width: 100%;">
                                @{
                                    double cumulative = 0.0;
                                }
                                @foreach (var slice in PieSlices)
                                {
                                    var startAngle = cumulative * 2 * Math.PI;
                                    var endAngle = (cumulative + slice.Share) * 2 * Math.PI;
                                    cumulative += slice.Share;

                                    var x1 = Math.Cos(startAngle);
                                    var y1 = Math.Sin(startAngle);
                                    var x2 = Math.Cos(endAngle);
                                    var y2 = Math.Sin(endAngle);

                                    var largeArcFlag = slice.Share > 0.5 ? 1 : 0;
                                    var pathData = $"M 0 0 L {x1:F4} {y1:F4} A 1 1 0 {largeArcFlag} 1 {x2:F4} {y2:F4} Z";

                                    <path d="@pathData" fill="@slice.HexColor" stroke="#ffffff" stroke-width="0.02" />
                                }
                            </svg>
                        </div>
                        <div class="col-sm-6 mt-3 mt-sm-0">
                            <ul class="list-unstyled mb-0">
                                @foreach (var slice in PieSlices)
                                {
                                    <li class="d-flex align-items-center mb-2 small">
                                        <span class="d-inline-block rounded-circle me-2" style="width: 12px; height: 12px; background-color: @slice.HexColor;"></span>
                                        <span class="fw-semibold me-auto">@slice.Category</span>
                                        <span class="text-muted">@((slice.Share * 100).ToString("F1"))%</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 7-Day Outflow Trend -->
        <div class="col-lg-6">
            <div class="card stat-card shadow-sm border-0 p-4 bg-white h-100">
                <h6 class="fw-bold mb-3">Last 7 Days Outflow Distribution</h6>
                <div class="p-3 border rounded-3 bg-light">
                    <svg viewBox="0 0 350 130" style="width: 100%; height: 160px;">
                        @for (int i = 0; i < Last7DaysData.Count; i++)
                        {
                            var day = Last7DaysData[i];
                            var max = Math.Max(1m, Last7DaysData.Max(d => d.Amount));
                            var barHeight = (double)(day.Amount / max) * 85;
                            var x = 20 + (i * 45);
                            var y = 105 - barHeight;

                            <rect x="@x" y="@y" width="26" height="@barHeight" 
                                  rx="4" fill="@(IsSpendingTrendingUp ? "#ef4444" : "#22c55e")" opacity="0.85" />
                            
                            @:<text x="@(x + 13)" y="122" font-size="10" text-anchor="middle" fill="#64748b">@day.Date.ToString("ddd")</text>

                            @if (day.Amount > 0)
                            {
                                @:<text x="@(x + 13)" y="@(y - 4)" font-size="9" text-anchor="middle" font-weight="bold" fill="#334155">@day.Amount.ToString("F0")</text>
                            }
                        }
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Expense> allExpenses = new();
    private decimal TotalSpent => allExpenses.Sum(e => e.Amount);

    private record PieSlice(string Category, double Share, string HexColor);

    private List<PieSlice> PieSlices
    {
        get
        {
            if (TotalSpent == 0) return new();
            return allExpenses
                .GroupBy(e => e.Category)
                .Select(g => new PieSlice(
                    g.Key,
                    (double)(g.Sum(x => x.Amount) / TotalSpent),
                    GetHexColor(g.Key)
                ))
                .OrderByDescending(s => s.Share)
                .ToList();
        }
    }

    private List<(DateTime Date, decimal Amount)> Last7DaysData =>
        Enumerable.Range(0, 7)
            .Select(offset => DateTime.Today.AddDays(-6 + offset))
            .Select(d => (Date: d, Amount: allExpenses.Where(e => e.DateIncurred.Date == d).Sum(e => e.Amount)))
            .ToList();

    private bool IsSpendingTrendingUp
    {
        get
        {
            var recent3 = allExpenses.Where(e => e.DateIncurred >= DateTime.Today.AddDays(-3)).Sum(e => e.Amount);
            var previous3 = allExpenses.Where(e => e.DateIncurred < DateTime.Today.AddDays(-3) && e.DateIncurred >= DateTime.Today.AddDays(-6)).Sum(e => e.Amount);
            return recent3 > previous3 && recent3 > 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        allExpenses = await db.Expenses.ToListAsync();
    }

    private string GetHexColor(string cat) => cat switch
    {
        "Food" => "#22c55e",
        "Academics" => "#3b82f6",
        "Transport" => "#f59e0b",
        "Data/Airtime" => "#ec4899",
        "Utilities" => "#8b5cf6",
        _ => "#64748b"
    };
}