@page "/study"
@rendermode InteractiveServer
@using CampusSpend.Models
@using CampusSpend.Data
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>StudySprint — Academic Command & Schedule Generator</PageTitle>

<div class="container-fluid px-4 pt-5 pb-5 min-vh-100 bg-light">
    
    <!-- Top Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 mt-3">
        <div>
            <h2 class="fw-bold text-dark mb-0">StudySprint Academic Command</h2>
            <small class="text-muted">Monday–Sunday structured routine, full course titles, recovery intervals, focus audio & periodic reminders.</small>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            <button class="btn btn-outline-primary btn-sm shadow-sm" @onclick="() => showFreeHoursModal = true">
                <i class="bi bi-clock-history me-1"></i> Configure Daily Free Hours
            </button>
            <button class="btn btn-primary btn-sm shadow-sm" @onclick="OpenAddCourseModal">
                <i class="bi bi-plus-circle me-1"></i> Register Course
            </button>
            <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="SeedSampleAcademicData">
                <i class="bi bi-magic me-1"></i> Sample Data
            </button>
        </div>
    </div>

    <!-- Active Single-Course Focus Timer Banner with Native Web Audio Ambience -->
    <div class="card stat-card shadow-sm border-0 mb-4 p-3 bg-white">
        <div class="row align-items-center">
            <div class="col-md-5 d-flex align-items-center gap-3">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle">
                    <i class="bi bi-stopwatch fs-3"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge @(isBreakMode ? "bg-info" : "bg-warning text-dark")">
                            @(isBreakMode ? "Break Session" : "Deep Work Focus")
                        </span>
                        @if (isTimerRunning)
                        {
                            <span class="badge bg-success-subtle text-success border border-success small">
                                <i class="bi bi-bell me-1"></i> Auto-reminder: every 10m
                            </span>
                        }
                    </div>
                    <h2 class="fw-bold mb-0 font-monospace">@TimeSpan.FromSeconds(timerSeconds).ToString(@"mm\:ss")</h2>
                    <small class="text-muted">
                        @if (ActiveCourseSession != null)
                        {
                            <span>Active: <strong>@ActiveCourseSession.Title</strong> (@ActiveCourseSession.Code — Slide @ActiveCourseSession.ActiveSlideUnderway)</span>
                        }
                        else
                        {
                            <span>No slide active. Choose a course below to begin.</span>
                        }
                    </small>
                </div>
            </div>
            <div class="col-md-7 text-md-end mt-3 mt-md-0">
                <!-- Synthesized Ambient Noise Controller -->
                <div class="btn-group btn-group-sm me-2 shadow-sm">
                    <button class="btn @(isAmbiencePlaying ? "btn-dark text-warning" : "btn-outline-secondary")" @onclick="ToggleAmbience">
                        <i class="bi @(isAmbiencePlaying ? "bi-volume-up-fill" : "bi-headphones") me-1"></i>
                        @(isAmbiencePlaying ? $"{activeAmbienceType.ToUpper()} Sound Active" : "Focus Ambience")
                    </button>
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="visually-hidden">Toggle Ambience</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 small">
                        <li><h6 class="dropdown-header">Synthesized Noise</h6></li>
                        <li><button class="dropdown-item" @onclick='() => ChangeAmbience("brown")'>🪵 Deep Brown Noise (Heavy Focus)</button></li>
                        <li><button class="dropdown-item" @onclick='() => ChangeAmbience("pink")'>🌧️ Gentle Rain Waves</button></li>
                        <li><button class="dropdown-item" @onclick='() => ChangeAmbience("library")'>📚 Silent Library Ambience</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item text-danger" @onclick="StopAmbience">⏹ Mute Ambience</button></li>
                    </ul>
                </div>

                @if (ActiveCourseSession != null)
                {
                    @if (!isTimerRunning)
                    {
                        <button class="btn btn-success me-2 px-3 shadow-sm" @onclick="ResumeTimer">
                            <i class="bi bi-play-fill me-1"></i> Resume
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-danger me-2 px-3 shadow-sm" @onclick="StopTimer">
                            <i class="bi bi-pause-fill me-1"></i> Pause
                        </button>
                    }
                    <button class="btn btn-success me-2 px-3" @onclick="() => CompleteActiveSlide(ActiveCourseSession)">
                        <i class="bi bi-check2-circle me-1"></i> Mark Slide Done
                    </button>
                    <button class="btn btn-outline-secondary px-3" @onclick="() => CancelActiveSlide(ActiveCourseSession)">
                        Cancel Session
                    </button>
                }
                else
                {
                    <span class="text-muted small">Select "+ Start Slide" on any registered course to begin.</span>
                }
            </div>
        </div>
    </div>

    <!-- Alert / Collision Banner -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @alertMessage
            <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
        </div>
    }

    <!-- GPA Forecaster & Academic Standing Banner -->
    <div class="card stat-card shadow-sm border-0 mb-4 p-4 bg-white">
        <div class="row align-items-center">
            <div class="col-md-3 border-end">
                <small class="text-muted text-uppercase fw-semibold">Projected Semester GPA</small>
                <div class="display-5 fw-bold text-primary my-1">@ProjectedGPA.ToString("F2")</div>
                <span class="badge @GetGPABadgeClass()">@AcademicStanding</span>
            </div>
            <div class="col-md-9 ps-md-4 mt-3 mt-md-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-dark">Overall Syllabus Coverage</span>
                    <span class="fw-bold text-primary">@OverallSlideProgress.ToString("F0")% Completed</span>
                </div>
                <div class="progress rounded-pill mb-2" style="height: 12px;">
                    <div class="progress-bar rounded-pill @(OverallSlideProgress >= 80 ? "bg-success" : "bg-primary")" 
                         style="width: @(Math.Min(100, OverallSlideProgress))%"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                    <span>Total Registered Credits: <strong>@TotalCredits</strong></span>
                    <span>Total Slides Mastered: <strong>@courses.Sum(c => c.CoveredSlides) / @courses.Sum(c => c.TotalSlides)</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Monday to Sunday Routine Timetable -->
    <div class="card stat-card shadow-sm border-0 mb-4 p-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h5 class="fw-bold text-dark mb-0">Weekly Revision & Study Timetable (Mon – Sun)</h5>
                    <span class="badge @(isExamRevisionMode ? "bg-danger" : "bg-primary")">
                        @(isExamRevisionMode ? "Exam Revision Mode" : "Semester Routine Mode")
                    </span>
                </div>
                <small class="text-muted">
                    @(isExamRevisionMode 
                        ? "Prioritizes upcoming exam dates, course difficulty, and lowest grasp topics with study sessions and scheduled breaks." 
                        : "Schedules sessions across Monday to Sunday aligned with class lecture days (previews, reviews, and recovery breaks).")
                </small>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
                <button class="btn btn-outline-primary btn-sm shadow-sm" @onclick="GenerateSemesterSchedule">
                    <i class="bi bi-calendar-week me-1"></i> Generate Weekly Routine
                </button>
                <button class="btn btn-danger btn-sm shadow-sm" @onclick="() => showExamDatesModal = true">
                    <i class="bi bi-fire me-1"></i> Exam Revision Mode
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSchedule">
                    Clear
                </button>
            </div>
        </div>

        @if (scheduleSlots.Count == 0)
        {
            <div class="p-4 text-center border rounded bg-light text-muted small">
                No timetable generated yet. Click <strong>"Generate Weekly Routine"</strong> to automatically map Monday to Sunday study blocks with recovery breaks based on your class timetable.
            </div>
        }
        else
        {
            <!-- Grouped Monday to Sunday View -->
            <div class="row g-3">
                @foreach (var day in WeekDayOrder)
                {
                    var daySlots = scheduleSlots.Where(s => s.DayOfWeek == day).ToList();
                    var freeWindow = freeWindows.FirstOrDefault(w => w.DayOfWeek == day);

                    <div class="col-12">
                        <div class="card border rounded-3 overflow-hidden shadow-none mb-1">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                                <div>
                                    <span class="fw-bold text-dark fs-6 me-2">@day</span>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>Free Window: <strong>@(freeWindow?.IsAvailable == true ? freeWindow.TimeRange : "Rest / Off Day")</strong>
                                    </small>
                                </div>
                                <span class="badge bg-secondary">@daySlots.Count Planned Session(s)</span>
                            </div>
                            <div class="card-body p-0">
                                @if (!daySlots.Any())
                                {
                                    <div class="p-3 text-muted small text-center">
                                        No study sessions assigned for @day. Relax or catch up on backlog!
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive mb-0">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light small text-uppercase" style="font-size: 0.72rem;">
                                                <tr>
                                                    <th style="width: 180px;">Time Interval</th>
                                                    <th>Course Name</th>
                                                    <th>Mode / Reason</th>
                                                    <th>Target Milestone</th>
                                                    <th class="text-center" style="width: 130px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < daySlots.Count; i++)
                                                {
                                                    var slot = daySlots[i];
                                                    var crs = courses.FirstOrDefault(c => c.Code == slot.CourseCode);
                                                    var courseDisplayName = crs?.Title ?? slot.CourseCode;

                                                    <tr class="@(slot.IsCompleted ? "table-light opacity-75" : "")">
                                                        <td class="small fw-semibold text-primary">
                                                            <i class="bi bi-stopwatch me-1"></i>@slot.TimeSlot
                                                        </td>
                                                        <td>
                                                            <div class="fw-bold text-dark">@courseDisplayName</div>
                                                            <small class="badge bg-dark me-1" style="font-size: 0.7rem;">@slot.CourseCode</small>
                                                            @if (crs != null)
                                                            {
                                                                <small class="text-muted" style="font-size: 0.75rem;">(Class on @crs.ClassDay)</small>
                                                            }
                                                        </td>
                                                        <td>
                                                            <span class="badge @GetSlotBadgeClass(slot.Reason)">
                                                                @slot.Reason
                                                            </span>
                                                        </td>
                                                        <td class="small text-muted">@slot.PlannedTopic</td>
                                                        <td class="text-center">
                                                            <button class="btn btn-sm @(slot.IsCompleted ? "btn-success" : "btn-outline-secondary") rounded-pill py-0 px-3"
                                                                    @onclick="() => ToggleScheduleSlot(slot)">
                                                                @(slot.IsCompleted ? "Done ✓" : "Mark Done")
                                                            </button>
                                                        </td>
                                                    </tr>

                                                    <!-- Automatic 15-Minute Scheduled Break Between Sessions -->
                                                    @if (i < daySlots.Count - 1)
                                                    {
                                                        <tr class="table-info bg-opacity-25" style="font-size: 0.78rem;">
                                                            <td colspan="5" class="py-1 px-3 text-info fw-semibold text-center">
                                                                <i class="bi bi-cup-hot-fill me-1"></i> 15-Minute Recovery Break & Hydration Window
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Exam Urgency Matrix -->
    <h5 class="fw-bold text-dark mb-3">Exam Urgency Matrix</h5>
    <div class="row g-3 mb-4">
        @if (!courses.Any(c => c.ExamDate.HasValue))
        {
            <div class="col-12">
                <div class="p-3 bg-white rounded border text-muted small text-center">
                    No exam dates scheduled yet. Click "Exam Revision Mode" above to assign dates and activate pacing.
                </div>
            </div>
        }
        @foreach (var c in courses.Where(c => c.ExamDate.HasValue).OrderBy(c => c.ExamDate))
        {
            var daysLeft = (c.ExamDate!.Value.Date - DateTime.Today).Days;
            <div class="col-md-6 col-xl-4">
                <div class="card stat-card shadow-sm border-0 border-start border-4 @GetUrgencyBorder(daysLeft) p-3 bg-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-dark me-1">@c.Code</span>
                            <span class="fw-bold text-dark">@c.Title</span>
                        </div>
                        <span class="badge @GetUrgencyBadge(daysLeft)">
                            @(daysLeft < 0 ? "Past Due" : daysLeft == 0 ? "Today!" : $"{daysLeft} Days Left")
                        </span>
                    </div>
                    <div class="small text-muted mt-2 d-flex justify-content-between">
                        <span>Class: <strong>Every @c.ClassDay</strong></span>
                        <span>Exam: <strong>@c.ExamDate.Value.ToString("dd MMM yyyy")</strong></span>
                    </div>
                    @if (daysLeft > 0 && !c.IsFullyCovered)
                    {
                        var remaining = c.TotalSlides - c.CoveredSlides;
                        var dailyPace = Math.Ceiling((double)remaining / Math.Max(1, daysLeft));
                        <div class="small text-danger fw-semibold mt-1">
                            Pacing: Study ~@dailyPace slide(s)/day to finish deck before exam.
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Registered Courses Grid with Difficulty & Understanding Badges -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">Registered Semester Courses (@courses.Count)</h5>
    </div>

    <div class="row g-3 mb-5">
        @foreach (var c in courses)
        {
            var isCurrentCourseActive = c.ActiveSlideUnderway.HasValue;
            var isAnotherCourseActive = ActiveCourseSession != null && ActiveCourseSession.Id != c.Id;

            <div class="col-md-6 col-xl-4">
                <div class="card stat-card shadow-sm border-0 p-3 bg-white h-100 position-relative @(isCurrentCourseActive ? "border border-2 border-warning" : "")">
                    
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-dark px-2 py-1 me-1">@c.Code</span>
                            <span class="badge @(c.Difficulty == "Hard" ? "bg-danger" : c.Difficulty == "Medium" ? "bg-warning text-dark" : "bg-info text-dark") me-1">
                                @c.Difficulty
                            </span>
                            <span class="badge bg-light text-primary border fw-semibold">Class: @c.ClassDay</span>
                            <h6 class="fw-bold text-dark mt-2 mb-0">@c.Title</h6>
                        </div>
                        <span class="badge @(c.IsFullyCovered ? "bg-success" : "bg-primary")">
                            @(c.IsFullyCovered ? "Mastered 🎉" : $"{c.SlideProgress:F0}%")
                        </span>
                    </div>

                    <!-- Understanding Grasp Bar -->
                    <div class="small text-muted d-flex justify-content-between mt-2 mb-1">
                        <span>Grasp / Understanding:</span>
                        <strong class="@(c.UnderstandingPercentage < 40 ? "text-danger" : c.UnderstandingPercentage < 70 ? "text-warning" : "text-success")">
                            @c.UnderstandingPercentage%
                        </strong>
                    </div>
                    <div class="progress rounded-pill mb-2" style="height: 6px;">
                        <div class="progress-bar rounded-pill @(c.UnderstandingPercentage < 40 ? "bg-danger" : c.UnderstandingPercentage < 70 ? "bg-warning" : "bg-success")"
                             style="width: @c.UnderstandingPercentage%"></div>
                    </div>

                    <!-- Target Grade Selector -->
                    <div class="d-flex justify-content-between align-items-center small my-2 bg-light p-2 rounded">
                        <span class="fw-semibold text-muted">Target Grade:</span>
                        <select class="form-select form-select-sm w-auto py-0 fw-bold text-primary" 
                                value="@c.TargetGrade" 
                                @onchange="(e) => UpdateTargetGrade(c, e.Value?.ToString())">
                            <option value="A">A (4.00)</option>
                            <option value="A-">A- (3.75)</option>
                            <option value="B+">B+ (3.50)</option>
                            <option value="B">B (3.25)</option>
                            <option value="B-">B- (3.00)</option>
                            <option value="C+">C+ (2.75)</option>
                            <option value="C">C (2.50)</option>
                            <option value="C-">C- (2.00)</option>
                            <option value="D">D (1.50)</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Deck Coverage:</span>
                        <span class="fw-bold text-dark">@c.CoveredSlides / @c.TotalSlides Slides</span>
                    </div>

                    <div class="progress rounded-pill mb-3" style="height: 10px;">
                        <div class="progress-bar rounded-pill @(c.IsFullyCovered ? "bg-success" : "bg-primary")"
                             style="width: @(Math.Min(100, c.SlideProgress))%"></div>
                    </div>

                    <!-- Slide Session Controller -->
                    @if (isCurrentCourseActive)
                    {
                        <div class="p-2 mb-2 rounded bg-warning bg-opacity-10 border border-warning d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-warning text-dark me-1">
                                    <i class="bi bi-play-fill"></i> Underway
                                </span>
                                <span class="small fw-bold text-dark">Slide @c.ActiveSlideUnderway.Value</span>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-success py-0 px-2 fw-semibold" 
                                        @onclick="() => CompleteActiveSlide(c)">
                                    Done ✓
                                </button>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" 
                                        @onclick="() => CancelActiveSlide(c)">
                                    ✕
                                </button>
                            </div>
                        </div>
                    }
                    else if (!c.IsFullyCovered)
                    {
                        <div class="mb-2">
                            <button class="btn btn-sm btn-outline-primary w-100 fw-semibold" 
                                    disabled="@isAnotherCourseActive"
                                    title="@(isAnotherCourseActive ? "Complete your active course session first!" : "")"
                                    @onclick="() => PromptStartSlide(c)">
                                <i class="bi bi-book-half me-1"></i> Start Slide @(c.CoveredSlides + 1)
                            </button>
                        </div>
                    }

                    <!-- Manual Controls -->
                    <div class="d-flex gap-1 align-items-center mb-2">
                        <button class="btn btn-sm btn-light border text-muted flex-fill" 
                                disabled="@(c.CoveredSlides == 0 || isCurrentCourseActive)" 
                                @onclick="() => IncrementSlides(c, -1)">
                            -1 Slide
                        </button>
                        <button class="btn btn-sm btn-light border text-muted flex-fill" 
                                disabled="@(c.CoveredSlides + 5 > c.TotalSlides || isCurrentCourseActive)" 
                                @onclick="() => IncrementSlides(c, 5)">
                            +5 Jump
                        </button>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-2 mt-auto">
                        <button class="btn btn-sm btn-link text-primary p-0 text-decoration-none" @onclick="() => OpenEditCourseModal(c)">Edit</button>
                        <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none" @onclick="() => DeleteCourse(c.Id)">Remove</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: Configure Exam Dates & Trigger Revision Schedule -->
@if (showExamDatesModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow rounded-3">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-calendar2-check-fill me-2"></i>Exam Revision Planner</h5>
                    <button type="button" class="btn-close" @onclick="() => showExamDatesModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">Confirm exam dates for your courses. StudySprint will generate an intensive revision plan from Monday to Sunday, allocating extra sessions and recovery breaks to Hard courses and low-grasp topics.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light small">
                                <tr>
                                    <th>Code</th>
                                    <th>Title</th>
                                    <th>Difficulty</th>
                                    <th>Understanding</th>
                                    <th>Remaining Slides</th>
                                    <th>Exam Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in courses)
                                {
                                    <tr>
                                        <td><strong>@c.Code</strong></td>
                                        <td class="small">@c.Title</td>
                                        <td>
                                            <span class="badge @(c.Difficulty == "Hard" ? "bg-danger" : c.Difficulty == "Medium" ? "bg-warning text-dark" : "bg-info text-dark")">
                                                @c.Difficulty
                                            </span>
                                        </td>
                                        <td class="small fw-semibold">@c.UnderstandingPercentage%</td>
                                        <td><span class="badge bg-secondary">@(c.TotalSlides - c.CoveredSlides) left</span></td>
                                        <td>
                                            <input type="date" class="form-control form-control-sm" @bind="c.ExamDate" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="() => showExamDatesModal = false">Cancel</button>
                    <button class="btn btn-sm btn-danger px-3 shadow-sm" @onclick="GenerateExamRevisionSchedule">
                        <i class="bi bi-lightning-charge-fill me-1"></i> Generate Revision Schedule
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 1: Configure Daily Free Study Hours (Monday - Sunday) -->
@if (showFreeHoursModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-3">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Configure Daily Free Study Windows</h5>
                    <button type="button" class="btn-close" @onclick="() => showFreeHoursModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">Set the exact hours you are free to study from Monday through Sunday. The timetable will split these windows into study sessions separated by 15-minute breaks.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light small">
                                <tr>
                                    <th>Day</th>
                                    <th>Free Study Window</th>
                                    <th class="text-center">Available?</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in freeWindows)
                                {
                                    <tr>
                                        <td><strong>@w.DayOfWeek</strong></td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="w.TimeRange" placeholder="e.g. 18:00 - 21:00" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input" @bind="w.IsAvailable" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary btn-sm" @onclick="SaveFreeWindows">Save Free Hours</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 2: Set Focus Duration -->
@if (showDurationModal && selectedCourseToStart != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
