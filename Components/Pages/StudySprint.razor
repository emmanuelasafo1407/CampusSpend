@page "/study"
@rendermode InteractiveServer
@using CampusSpend.Models
@using CampusSpend.Data
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>StudySprint — Academic Command & Schedule Generator</PageTitle>

<div class="container-fluid px-4 pt-5 pb-5 min-vh-100 bg-light">
    
    <!-- Top Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 mt-3">
        <div>
            <h2 class="fw-bold text-dark mb-0">StudySprint Academic Command</h2>
            <small class="text-muted">Class-aligned timetable generation, automatic 10-minute reminders & single-focus deck pacing.</small>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button class="btn btn-outline-primary btn-sm shadow-sm" @onclick="() => showFreeHoursModal = true">
                <i class="bi bi-clock-history me-1"></i> Configure Free Study Hours
            </button>
            <button class="btn btn-primary btn-sm shadow-sm" @onclick="OpenAddCourseModal">
                <i class="bi bi-plus-circle me-1"></i> Register Course
            </button>
            <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="SeedSampleAcademicData">
                <i class="bi bi-magic me-1"></i> Sample Data
            </button>
        </div>
    </div>

    <!-- Active Single-Course Focus Timer Banner with Auto-Reminder Display -->
    <div class="card stat-card shadow-sm border-0 mb-4 p-3 bg-white">
        <div class="row align-items-center">
            <div class="col-md-5 d-flex align-items-center gap-3">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle">
                    <i class="bi bi-stopwatch fs-3"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge @(isBreakMode ? "bg-info" : "bg-warning text-dark")">
                            @(isBreakMode ? "Break Session" : "Deep Work Focus")
                        </span>
                        @if (isTimerRunning)
                        {
                            <span class="badge bg-success-subtle text-success border border-success small">
                                <i class="bi bi-bell me-1"></i> Auto-reminder: every 10m
                            </span>
                        }
                    </div>
                    <h2 class="fw-bold mb-0 font-monospace">@TimeSpan.FromSeconds(timerSeconds).ToString(@"mm\:ss")</h2>
                    <small class="text-muted">
                        @if (ActiveCourseSession != null)
                        {
                            <span>Active: <strong>@ActiveCourseSession.Code</strong> (Slide @ActiveCourseSession.ActiveSlideUnderway)</span>
                        }
                        else
                        {
                            <span>No slide active. Choose a course below to begin.</span>
                        }
                    </small>
                </div>
            </div>
            <div class="col-md-7 text-md-end mt-3 mt-md-0">
                @if (ActiveCourseSession != null)
                {
                    @if (!isTimerRunning)
                    {
                        <button class="btn btn-success me-2 px-3 shadow-sm" @onclick="ResumeTimer">
                            <i class="bi bi-play-fill me-1"></i> Resume
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-danger me-2 px-3 shadow-sm" @onclick="StopTimer">
                            <i class="bi bi-pause-fill me-1"></i> Pause
                        </button>
                    }
                    <button class="btn btn-success me-2 px-3" @onclick="() => CompleteActiveSlide(ActiveCourseSession)">
                        <i class="bi bi-check2-circle me-1"></i> Mark Slide Done
                    </button>
                    <button class="btn btn-outline-secondary px-3" @onclick="() => CancelActiveSlide(ActiveCourseSession)">
                        Cancel Session
                    </button>
                }
                else
                {
                    <span class="text-muted small">Select "+ Start Slide" on any registered course to begin.</span>
                }
            </div>
        </div>
    </div>

    <!-- Alert / Collision Banner -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @alertMessage
            <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
        </div>
    }

    <!-- GPA Forecaster & Academic Standing Banner -->
    <div class="card stat-card shadow-sm border-0 mb-4 p-4 bg-white">
        <div class="row align-items-center">
            <div class="col-md-3 border-end">
                <small class="text-muted text-uppercase fw-semibold">Projected Semester GPA</small>
                <div class="display-5 fw-bold text-primary my-1">@ProjectedGPA.ToString("F2")</div>
                <span class="badge @GetGPABadgeClass()">@AcademicStanding</span>
            </div>
            <div class="col-md-9 ps-md-4 mt-3 mt-md-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-dark">Overall Syllabus Coverage</span>
                    <span class="fw-bold text-primary">@OverallSlideProgress.ToString("F0")% Completed</span>
                </div>
                <div class="progress rounded-pill mb-2" style="height: 12px;">
                    <div class="progress-bar rounded-pill @(OverallSlideProgress >= 80 ? "bg-success" : "bg-primary")" 
                         style="width: @(Math.Min(100, OverallSlideProgress))%"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                    <span>Total Registered Credits: <strong>@TotalCredits</strong></span>
                    <span>Total Slides Mastered: <strong>@courses.Sum(c => c.CoveredSlides) / @courses.Sum(c => c.TotalSlides)</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Smart Generated Study Timetable (Aligned to Class Timetable & Free Time) -->
    <div class="card stat-card shadow-sm border-0 mb-4 p-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold text-dark mb-0">Class-Aligned Revision Timetable</h5>
                <small class="text-muted">Schedules revision right around your class days during your configured free hours.</small>
            </div>
            <div class="d-flex gap-2 mt-2 mt-md-0">
                <button class="btn btn-outline-primary btn-sm shadow-sm" @onclick="GenerateSmartSchedule">
                    <i class="bi bi-cpu me-1"></i> Auto-Generate Aligned Schedule
                </button>
                <button class="btn btn-outline-danger btn-sm shadow-sm" @onclick="ClearSchedule">
                    Clear
                </button>
            </div>
        </div>

        @if (scheduleSlots.Count == 0)
        {
            <div class="p-4 text-center border rounded bg-light text-muted small">
                No timetable generated yet. Click <strong>"Auto-Generate Aligned Schedule"</strong> to generate study sessions synchronized with your class schedule and free study windows.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Study Day</th>
                            <th>Free Window</th>
                            <th>Course</th>
                            <th>Class Lecture Day</th>
                            <th>Pedagogical Goal & Reason</th>
                            <th>Planned Task</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in scheduleSlots)
                        {
                            var crs = courses.FirstOrDefault(c => c.Code == slot.CourseCode);
                            <tr class="@(slot.IsCompleted ? "table-light opacity-75" : "")">
                                <td><strong>@slot.DayOfWeek</strong></td>
                                <td class="small text-muted">@slot.TimeSlot</td>
                                <td><span class="badge bg-dark">@slot.CourseCode</span></td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-calendar3 me-1"></i>Class on @(crs?.ClassDay ?? "N/A")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(slot.Reason.Contains("Post") ? "bg-info text-dark" : "bg-primary")">
                                        @slot.Reason
                                    </span>
                                </td>
                                <td class="small">@slot.PlannedTopic</td>
                                <td class="text-center">
                                    <button class="btn btn-sm @(slot.IsCompleted ? "btn-success" : "btn-outline-secondary") rounded-pill py-0 px-3"
                                            @onclick="() => ToggleScheduleSlot(slot)">
                                        @(slot.IsCompleted ? "Completed ✓" : "Mark Done")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Exam Urgency Matrix -->
    <h5 class="fw-bold text-dark mb-3">Exam Urgency Matrix</h5>
    <div class="row g-3 mb-4">
        @if (!courses.Any(c => c.ExamDate.HasValue))
        {
            <div class="col-12">
                <div class="p-3 bg-white rounded border text-muted small text-center">
                    No exam dates scheduled yet.
                </div>
            </div>
        }
        @foreach (var c in courses.Where(c => c.ExamDate.HasValue).OrderBy(c => c.ExamDate))
        {
            var daysLeft = (c.ExamDate!.Value.Date - DateTime.Today).Days;
            <div class="col-md-6 col-xl-4">
                <div class="card stat-card shadow-sm border-0 border-start border-4 @GetUrgencyBorder(daysLeft) p-3 bg-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-dark me-1">@c.Code</span>
                            <span class="fw-bold text-dark">@c.Title</span>
                        </div>
                        <span class="badge @GetUrgencyBadge(daysLeft)">
                            @(daysLeft < 0 ? "Past Due" : daysLeft == 0 ? "Today!" : $"{daysLeft} Days Left")
                        </span>
                    </div>
                    <div class="small text-muted mt-2 d-flex justify-content-between">
                        <span>Class: <strong>Every @c.ClassDay</strong></span>
                        <span>Exam: <strong>@c.ExamDate.Value.ToString("dd MMM yyyy")</strong></span>
                    </div>
                    @if (daysLeft > 0 && !c.IsFullyCovered)
                    {
                        var remaining = c.TotalSlides - c.CoveredSlides;
                        var dailyPace = Math.Ceiling((double)remaining / Math.Max(1, daysLeft));
                        <div class="small text-danger fw-semibold mt-1">
                            Pacing: Study ~@dailyPace slide(s)/day to finish deck before exam.
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Registered Courses Grid -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">Registered Courses & Class Timetable Days (@courses.Count)</h5>
    </div>

    <div class="row g-3 mb-5">
        @foreach (var c in courses)
        {
            var isCurrentCourseActive = c.ActiveSlideUnderway.HasValue;
            var isAnotherCourseActive = ActiveCourseSession != null && ActiveCourseSession.Id != c.Id;

            <div class="col-md-6 col-xl-4">
                <div class="card stat-card shadow-sm border-0 p-3 bg-white h-100 position-relative @(isCurrentCourseActive ? "border border-2 border-warning" : "")">
                    
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-dark px-2 py-1 me-1">@c.Code</span>
                            <span class="badge bg-light text-primary border fw-semibold">Class: @c.ClassDay</span>
                            <h6 class="fw-bold text-dark mt-2 mb-0">@c.Title</h6>
                        </div>
                        <span class="badge @(c.IsFullyCovered ? "bg-success" : "bg-primary")">
                            @(c.IsFullyCovered ? "Mastered 🎉" : $"{c.SlideProgress:F0}%")
                        </span>
                    </div>

                    <!-- Target Grade Selector -->
                    <div class="d-flex justify-content-between align-items-center small my-2 bg-light p-2 rounded">
                        <span class="fw-semibold text-muted">Target Grade:</span>
                        <select class="form-select form-select-sm w-auto py-0 fw-bold text-primary" 
                                value="@c.TargetGrade" 
                                @onchange="(e) => UpdateTargetGrade(c, e.Value?.ToString())">
                            <option value="A">A (4.00)</option>
                            <option value="A-">A- (3.75)</option>
                            <option value="B+">B+ (3.50)</option>
                            <option value="B">B (3.25)</option>
                            <option value="B-">B- (3.00)</option>
                            <option value="C+">C+ (2.75)</option>
                            <option value="C">C (2.50)</option>
                            <option value="C-">C- (2.00)</option>
                            <option value="D">D (1.50)</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Deck Coverage:</span>
                        <span class="fw-bold text-dark">@c.CoveredSlides / @c.TotalSlides Slides</span>
                    </div>

                    <div class="progress rounded-pill mb-3" style="height: 10px;">
                        <div class="progress-bar rounded-pill @(c.IsFullyCovered ? "bg-success" : "bg-primary")"
                             style="width: @(Math.Min(100, c.SlideProgress))%"></div>
                    </div>

                    <!-- Slide Session Controller -->
                    @if (isCurrentCourseActive)
                    {
                        <div class="p-2 mb-2 rounded bg-warning bg-opacity-10 border border-warning d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-warning text-dark me-1">
                                    <i class="bi bi-play-fill"></i> Underway
                                </span>
                                <span class="small fw-bold text-dark">Slide @c.ActiveSlideUnderway.Value</span>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-success py-0 px-2 fw-semibold" 
                                        @onclick="() => CompleteActiveSlide(c)">
                                    Done ✓
                                </button>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" 
                                        @onclick="() => CancelActiveSlide(c)">
                                    ✕
                                </button>
                            </div>
                        </div>
                    }
                    else if (!c.IsFullyCovered)
                    {
                        <div class="mb-2">
                            <button class="btn btn-sm btn-outline-primary w-100 fw-semibold" 
                                    disabled="@isAnotherCourseActive"
                                    title="@(isAnotherCourseActive ? "Complete your active course session first!" : "")"
                                    @onclick="() => PromptStartSlide(c)">
                                <i class="bi bi-book-half me-1"></i> Start Slide @(c.CoveredSlides + 1)
                            </button>
                        </div>
                    }

                    <!-- Manual Controls -->
                    <div class="d-flex gap-1 align-items-center mb-2">
                        <button class="btn btn-sm btn-light border text-muted flex-fill" 
                                disabled="@(c.CoveredSlides == 0 || isCurrentCourseActive)" 
                                @onclick="() => IncrementSlides(c, -1)">
                            -1 Slide
                        </button>
                        <button class="btn btn-sm btn-light border text-muted flex-fill" 
                                disabled="@(c.CoveredSlides + 5 > c.TotalSlides || isCurrentCourseActive)" 
                                @onclick="() => IncrementSlides(c, 5)">
                            +5 Jump
                        </button>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-2 mt-auto">
                        <button class="btn btn-sm btn-link text-primary p-0 text-decoration-none" @onclick="() => OpenEditCourseModal(c)">Edit</button>
                        <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none" @onclick="() => DeleteCourse(c.Id)">Remove</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal 1: Configure Free Study Hours for Each Day -->
@if (showFreeHoursModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-3">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Configure Weekly Free Study Windows</h5>
                    <button type="button" class="btn-close" @onclick="() => showFreeHoursModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">Define the exact time range you are free to study on each day. The auto-generator will strictly schedule revision inside these windows.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light small">
                                <tr>
                                    <th>Day</th>
                                    <th>Free Study Window</th>
                                    <th class="text-center">Available?</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in freeWindows)
                                {
                                    <tr>
                                        <td><strong>@w.DayOfWeek</strong></td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="w.TimeRange" placeholder="e.g. 18:00 - 20:00" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input" @bind="w.IsAvailable" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary btn-sm" @onclick="SaveFreeWindows">Save Free Hours</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 2: Set Focus Duration -->
@if (showDurationModal && selectedCourseToStart != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow rounded-3">
                <div class="modal-header">
                    <h6 class="modal-title fw-bold">Set Focus Duration</h6>
                    <button type="button" class="btn-close" @onclick="() => showDurationModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Course: <strong>@selectedCourseToStart.Code</strong> (Slide @(selectedCourseToStart.CoveredSlides + 1))</p>
                    <label class="form-label small fw-semibold">Target Time (Minutes):</label>
                    <div class="input-group mb-2">
                        <input type="number" class="form-control" @bind="targetSlideMinutes" min="5" max="180" />
                        <span class="input-group-text">mins</span>
                    </div>
                    <small class="text-success d-block mb-3">
                        <i class="bi bi-info-circle me-1"></i> Automatic reminder alerts will sound every 10 minutes with your remaining time.
                    </small>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => targetSlideMinutes = 15">15m</button>
                        <button class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => targetSlideMinutes = 25">25m</button>
                        <button class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => targetSlideMinutes = 45">45m</button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="() => showDurationModal = false">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmStartSlideWithDuration">Start Focus</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 3: Register or Edit Course (With Class Timetable Day) -->
@if (showCourseModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-3">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@(editingCourseId.HasValue ? "Edit Course" : "Register Course")</h5>
                    <button type="button" class="btn-close" @onclick="() => showCourseModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Course Code:</label>
                            <input type="text" class="form-control" @bind="courseModel.Code" placeholder="e.g. ENGR 111" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Class Timetable Day:</label>
                            <select class="form-select" @bind="courseModel.ClassDay">
                                <option value="Monday">Monday</option>
                                <option value="Tuesday">Tuesday</option>
                                <option value="Wednesday">Wednesday</option>
                                <option value="Thursday">Thursday</option>
                                <option value="Friday">Friday</option>
                                <option value="Saturday">Saturday</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Course Title:</label>
                        <input type="text" class="form-control" @bind="courseModel.Title" placeholder="e.g. Machine Learning" />
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Credit Hours:</label>
                            <input type="number" class="form-control" @bind="courseModel.CreditHours" min="1" max="6" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Target Grade:</label>
                            <select class="form-select" @bind="courseModel.TargetGrade">
                                <option value="A">A (4.00)</option>
                                <option value="A-">A- (3.75)</option>
                                <option value="B+">B+ (3.50)</option>
                                <option value="B">B (3.25)</option>
                                <option value="B-">B- (3.00)</option>
                                <option value="C+">C+ (2.75)</option>
                                <option value="C">C (2.50)</option>
                                <option value="C-">C- (2.00)</option>
                                <option value="D">D (1.50)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Total Slides:</label>
                            <input type="number" class="form-control" @bind="courseModel.TotalSlides" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Covered Slides:</label>
                            <input type="number" class="form-control" @bind="courseModel.CoveredSlides" min="0" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Exam Date:</label>
                        <input type="date" class="form-control" @bind="courseModel.ExamDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCourseModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveCourse">Save Course</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<SemesterCourse> courses = new();
    private List<StudyScheduleSlot> scheduleSlots = new();
    private List<UserFreeWindow> freeWindows = new();

    private SemesterCourse courseModel = new();
    private int? editingCourseId = null;
    private bool showCourseModal = false;
    private bool showFreeHoursModal = false;

    // Single Focus State
    private SemesterCourse? ActiveCourseSession => courses.FirstOrDefault(c => c.ActiveSlideUnderway.HasValue);
    private SemesterCourse? selectedCourseToStart = null;
    private int targetSlideMinutes = 25;
    private bool showDurationModal = false;
    private string? alertMessage = null;

    // Timer & Automatic 10-Minute Reminder Tracking
    private System.Threading.Timer? focusTicker;
    private int timerSeconds = 25 * 60;
    private int initialDurationSeconds = 25 * 60;
    private int elapsedSeconds = 0;
    private bool isTimerRunning = false;
    private bool isBreakMode = false;

    private int TotalCredits => courses.Sum(c => c.CreditHours);

    private double ProjectedGPA =>
        TotalCredits > 0
            ? courses.Sum(c => c.GradePoint * c.CreditHours) / TotalCredits
            : 0.0;

    private string AcademicStanding => ProjectedGPA switch
    {
        >= 3.60 => "First Class Honours 🎓",
        >= 3.00 => "Second Class Upper",
        >= 2.50 => "Second Class Lower",
        >= 2.00 => "Third Class",
        > 0.00 => "Pass",
        _ => "No Grades Set"
    };

    private double OverallSlideProgress =>
        courses.Sum(c => c.TotalSlides) > 0
            ? ((double)courses.Sum(c => c.CoveredSlides) / courses.Sum(c => c.TotalSlides)) * 100
            : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAcademicDataAsync();
    }

    private async Task LoadAcademicDataAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        courses = await db.SemesterCourses.OrderBy(c => c.Code).ToListAsync();
        scheduleSlots = await db.StudyScheduleSlots.ToListAsync();
        freeWindows = await db.UserFreeWindows.ToListAsync();

        if (!freeWindows.Any())
        {
            string[] weekDays = { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
            foreach (var d in weekDays)
            {
                var defaultWindow = d is "Saturday" or "Sunday" ? "14:00 - 17:00" : "18:30 - 20:30";
                freeWindows.Add(new UserFreeWindow { DayOfWeek = d, TimeRange = defaultWindow, IsAvailable = true });
            }
            db.UserFreeWindows.AddRange(freeWindows);
            await db.SaveChangesAsync();
        }
    }

    private async Task SaveFreeWindows()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        foreach (var fw in freeWindows)
        {
            var match = await db.UserFreeWindows.FindAsync(fw.Id);
            if (match != null)
            {
                match.TimeRange = fw.TimeRange;
                match.IsAvailable = fw.IsAvailable;
            }
        }
        await db.SaveChangesAsync();
        showFreeHoursModal = false;
        await LoadAcademicDataAsync();
    }

    // Pedagogical Timetable Generator: Class Day Alignment + Free Time Matching
    private async Task GenerateSmartSchedule()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        db.StudyScheduleSlots.RemoveRange(db.StudyScheduleSlots);

        if (!courses.Any()) return;

        var availableWindows = freeWindows.Where(w => w.IsAvailable).ToList();
        if (!availableWindows.Any()) return;

        string[] dayOrder = { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

        foreach (var course in courses)
        {
            int classDayIndex = Array.IndexOf(dayOrder, course.ClassDay);
            if (classDayIndex == -1) classDayIndex = 0;

            // Strategy 1: Post-lecture review on the same evening of class or the day after
            int postReviewDayIndex = (classDayIndex + 1) % dayOrder.Length;
            string postReviewDay = dayOrder[postReviewDayIndex];
            var postWindow = availableWindows.FirstOrDefault(w => w.DayOfWeek == postReviewDay) 
                             ?? availableWindows.FirstOrDefault(w => w.DayOfWeek == course.ClassDay);

            if (postWindow != null)
            {
                db.StudyScheduleSlots.Add(new StudyScheduleSlot
                {
                    DayOfWeek = postWindow.DayOfWeek,
                    TimeSlot = postWindow.TimeRange,
                    CourseCode = course.Code,
                    PlannedTopic = $"Consolidate slides & review lecture notes from {course.ClassDay}'s class",
                    Reason = "Post-Lecture Consolidation",
                    IsCompleted = false
                });
            }

            // Strategy 2: Pre-lecture preparation the day before class
            int prePrepDayIndex = (classDayIndex - 1 + dayOrder.Length) % dayOrder.Length;
            string prePrepDay = dayOrder[prePrepDayIndex];
            var preWindow = availableWindows.FirstOrDefault(w => w.DayOfWeek == prePrepDay);

            if (preWindow != null)
            {
                var nextSlide = course.CoveredSlides + 1;
                db.StudyScheduleSlots.Add(new StudyScheduleSlot
                {
                    DayOfWeek = preWindow.DayOfWeek,
                    TimeSlot = preWindow.TimeRange,
                    CourseCode = course.Code,
                    PlannedTopic = $"Preview Slide {nextSlide} ahead of {course.ClassDay}'s lecture",
                    Reason = "Pre-Lecture Preview",
                    IsCompleted = false
                });
            }
        }

        await db.SaveChangesAsync();
        await LoadAcademicDataAsync();
    }

