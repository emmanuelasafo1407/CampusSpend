    // Slide Focus Session & Automatic 10-Minute Reminder Engine
    private void PromptStartSlide(SemesterCourse c)
    {
        if (ActiveCourseSession != null)
        {
            alertMessage = $"Focus collision: You are already studying {ActiveCourseSession.Code} (Slide {ActiveCourseSession.ActiveSlideUnderway}). Complete or cancel it first!";
            return;
        }

        selectedCourseToStart = c;
        targetSlideMinutes = 25;
        showDurationModal = true;
    }

    private async Task ConfirmStartSlideWithDuration()
    {
        if (selectedCourseToStart == null) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.SemesterCourses.FindAsync(selectedCourseToStart.Id);
        if (match != null)
        {
            match.ActiveSlideUnderway = match.CoveredSlides + 1;
            await db.SaveChangesAsync();
        }

        showDurationModal = false;
        alertMessage = null;

        initialDurationSeconds = Math.Max(1, targetSlideMinutes) * 60;
        timerSeconds = initialDurationSeconds;
        elapsedSeconds = 0;
        isBreakMode = false;
        isTimerRunning = true;
        RunTicker();

        await LoadAcademicDataAsync();
    }

    private void ResumeTimer()
    {
        isTimerRunning = true;
        RunTicker();
    }

    private void RunTicker()
    {
        focusTicker?.Dispose();
        focusTicker = new System.Threading.Timer(async _ =>
        {
            if (timerSeconds > 0)
            {
                timerSeconds--;
                elapsedSeconds++;

                // AUTOMATIC 10-MINUTE REMINDER TRIGGER (every 600 seconds)
                if (elapsedSeconds > 0 && elapsedSeconds % 600 == 0 && timerSeconds > 0)
                {
                    int minutesLeft = timerSeconds / 60;
                    int minutesElapsed = elapsedSeconds / 60;

                    await InvokeAsync(async () =>
                    {
                        try
                        {
                            await JS.InvokeVoidAsync("playStudyChime");
                            await JS.InvokeVoidAsync("triggerStudyAlert",
                                $"StudySprint Alert: 10 mins passed!",
                                $"{minutesElapsed} minutes elapsed on {ActiveCourseSession?.Code}. {minutesLeft} minutes remaining.");
                        }
                        catch { }
                    });
                }

                await InvokeAsync(StateHasChanged);
            }
            else
            {
                // Final completion alert
                isTimerRunning = false;
                focusTicker?.Dispose();
                await InvokeAsync(async () =>
                {
                    try
                    {
                        await JS.InvokeVoidAsync("playStudyChime");
                        await JS.InvokeVoidAsync("triggerStudyAlert", 
                            "Session Concluded! 🎯", 
                            $"Your scheduled time for {ActiveCourseSession?.Code} has ended. Mark your slide done!");
                    }
                    catch { }
                    StateHasChanged();
                });
            }
        }, null, 0, 1000);
    }

    private void StopTimer()
    {
        isTimerRunning = false;
        focusTicker?.Dispose();
    }

    private async Task CompleteActiveSlide(SemesterCourse c)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.SemesterCourses.FindAsync(c.Id);
        if (match != null)
        {
            match.CoveredSlides = Math.Min(match.TotalSlides, match.CoveredSlides + 1);
            match.ActiveSlideUnderway = null;
            await db.SaveChangesAsync();
        }
        StopTimer();
        alertMessage = null;
        await LoadAcademicDataAsync();
    }

    private async Task CancelActiveSlide(SemesterCourse c)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.SemesterCourses.FindAsync(c.Id);
        if (match != null)
        {
            match.ActiveSlideUnderway = null;
            await db.SaveChangesAsync();
        }
        StopTimer();
        alertMessage = null;
        await LoadAcademicDataAsync();
    }

