}

@code {
    private List<SemesterCourse> courses = new();
    private List<StudyScheduleSlot> scheduleSlots = new();
    private List<UserFreeWindow> freeWindows = new();

    private readonly string[] WeekDayOrder = { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

    private SemesterCourse courseModel = new();
    private int? editingCourseId = null;
    private bool showCourseModal = false;
    private bool showFreeHoursModal = false;
    private bool showExamDatesModal = false;
    private bool isExamRevisionMode = false;

    // Ambient Noise Focus Audio State
    private bool isAmbiencePlaying = false;
    private string activeAmbienceType = "brown";

    // Single Focus State
    private SemesterCourse? ActiveCourseSession => courses.FirstOrDefault(c => c.ActiveSlideUnderway.HasValue);
    private SemesterCourse? selectedCourseToStart = null;
    private int targetSlideMinutes = 25;
    private bool showDurationModal = false;
    private string? alertMessage = null;

    // Timer & Automatic 10-Minute Reminder Tracking
    private System.Threading.Timer? focusTicker;
    private int timerSeconds = 25 * 60;
    private int initialDurationSeconds = 25 * 60;
    private int elapsedSeconds = 0;
    private bool isTimerRunning = false;
    private bool isBreakMode = false;

    private int TotalCredits => courses.Sum(c => c.CreditHours);

    private double ProjectedGPA =>
        TotalCredits > 0
            ? courses.Sum(c => c.GradePoint * c.CreditHours) / TotalCredits
            : 0.0;

    private string AcademicStanding => ProjectedGPA switch
    {
        >= 3.60 => "First Class Honours 🎓",
        >= 3.00 => "Second Class Upper",
        >= 2.50 => "Second Class Lower",
        >= 2.00 => "Third Class",
        > 0.00 => "Pass",
        _ => "No Grades Set"
    };

    private double OverallSlideProgress =>
        courses.Sum(c => c.TotalSlides) > 0
            ? ((double)courses.Sum(c => c.CoveredSlides) / courses.Sum(c => c.TotalSlides)) * 100
            : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAcademicDataAsync();
    }

    private async Task LoadAcademicDataAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        courses = await db.SemesterCourses.OrderBy(c => c.Code).ToListAsync();
        
        var rawSlots = await db.StudyScheduleSlots.ToListAsync();
        // Chronological Monday to Sunday ordering
        scheduleSlots = rawSlots
            .OrderBy(s => Array.IndexOf(WeekDayOrder, s.DayOfWeek))
            .ThenBy(s => s.TimeSlot)
            .ToList();

        freeWindows = await db.UserFreeWindows.ToListAsync();

        if (!freeWindows.Any())
        {
            foreach (var d in WeekDayOrder)
            {
                var defaultWindow = d is "Saturday" or "Sunday" ? "14:00 - 17:30" : "18:30 - 21:30";
                freeWindows.Add(new UserFreeWindow { DayOfWeek = d, TimeRange = defaultWindow, IsAvailable = true });
            }
            db.UserFreeWindows.AddRange(freeWindows);
            await db.SaveChangesAsync();
        }
    }

    private async Task SaveFreeWindows()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        foreach (var fw in freeWindows)
        {
            var match = await db.UserFreeWindows.FindAsync(fw.Id);
            if (match != null)
            {
                match.TimeRange = fw.TimeRange;
                match.IsAvailable = fw.IsAvailable;
            }
        }
        await db.SaveChangesAsync();
        showFreeHoursModal = false;
        await LoadAcademicDataAsync();
    }

    // Splits a configured window (e.g. "18:30 - 21:30") into two study intervals with a 15-minute scheduled recovery break
    private (string session1, string session2) SplitWindowIntoSessions(string timeRange)
    {
        try
        {
            var parts = timeRange.Split('-');
            if (parts.Length == 2 && 
                TimeSpan.TryParse(parts[0].Trim(), out var start) && 
                TimeSpan.TryParse(parts[1].Trim(), out var end))
            {
                var totalMinutes = (end - start).TotalMinutes;
                if (totalMinutes >= 60)
                {
                    var studyBlockDuration = Math.Floor((totalMinutes - 15) / 2);
                    var s1End = start.Add(TimeSpan.FromMinutes(studyBlockDuration));
                    var s2Start = s1End.Add(TimeSpan.FromMinutes(15)); // 15-min recovery break

                    string s1 = $"{start:hh\\:mm} - {s1End:hh\\:mm}";
                    string s2 = $"{s2Start:hh\\:mm} - {end:hh\\:mm}";
                    return (s1, s2);
                }
            }
        }
        catch { }

        return ("Session 1", "Session 2");
    }

    // MODE 1: Semester Study Schedule (Monday to Sunday Routine Aligned to Lecture Days)
    private async Task GenerateSemesterSchedule()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        db.StudyScheduleSlots.RemoveRange(db.StudyScheduleSlots);

        if (!courses.Any()) return;

        var availableWindows = freeWindows.Where(w => w.IsAvailable).ToList();
        if (!availableWindows.Any()) return;

        foreach (var day in WeekDayOrder)
        {
            var window = availableWindows.FirstOrDefault(w => w.DayOfWeek == day);
            if (window == null) continue;

            int dayIndex = Array.IndexOf(WeekDayOrder, day);
            string tomorrow = WeekDayOrder[(dayIndex + 1) % WeekDayOrder.Length];
            string yesterday = WeekDayOrder[(dayIndex - 1 + WeekDayOrder.Length) % WeekDayOrder.Length];

            // 1. Course with class today (post-lecture review)
            var courseToday = courses.FirstOrDefault(c => c.ClassDay == day);

            // 2. Course with class tomorrow (pre-lecture preview)
            var courseTomorrow = courses.FirstOrDefault(c => c.ClassDay == tomorrow);

            // 3. Fallback: Course with class yesterday or difficult courses
            var courseYesterday = courses.FirstOrDefault(c => c.ClassDay == yesterday)
                                  ?? courses.OrderByDescending(c => c.Difficulty == "Hard" ? 2 : 1).FirstOrDefault();

            var (session1Time, session2Time) = SplitWindowIntoSessions(window.TimeRange);

            // Allocate Session 1
            var primaryCourse = courseToday ?? courseTomorrow ?? courses.First();
            string primaryReason = courseToday != null ? "Post-Lecture Consolidation" : "Pre-Lecture Preview";
            string primaryTopic = courseToday != null
                ? $"Consolidate lecture notes & practice problems from {day}'s class"
                : $"Preview next slide deck ahead of {tomorrow}'s lecture";

            db.StudyScheduleSlots.Add(new StudyScheduleSlot
            {
                DayOfWeek = day,
                TimeSlot = session1Time,
                CourseCode = primaryCourse.Code,
                PlannedTopic = primaryTopic,
                Reason = primaryReason,
                IsCompleted = false
            });

            // Allocate Session 2
            var secondaryCourse = (courseTomorrow != null && courseTomorrow.Code != primaryCourse.Code) 
                ? courseTomorrow 
                : (courseYesterday != null && courseYesterday.Code != primaryCourse.Code) 
                    ? courseYesterday 
                    : courses.FirstOrDefault(c => c.Code != primaryCourse.Code) ?? primaryCourse;

            string secondaryReason = (secondaryCourse.Code == courseTomorrow?.Code) 
                ? "Pre-Lecture Preview" 
                : (secondaryCourse.Difficulty == "Hard") 
                    ? "Deep Concept Reinforcement" 
                    : "Problem Solving & Review";

            db.StudyScheduleSlots.Add(new StudyScheduleSlot
            {
                DayOfWeek = day,
                TimeSlot = session2Time,
                CourseCode = secondaryCourse.Code,
                PlannedTopic = $"Active recall & exercise review ({secondaryCourse.Title})",
                Reason = secondaryReason,
                IsCompleted = false
            });
        }

        await db.SaveChangesAsync();
        isExamRevisionMode = false;
        await LoadAcademicDataAsync();

        try
        {
            await JS.InvokeVoidAsync("playStudyChime");
            await JS.InvokeVoidAsync("triggerStudyAlert", "Weekly Routine Active!", "Structured Monday to Sunday timetable generated with recovery breaks.");
        }
        catch { }
    }

    // MODE 2: Exam Revision Mode (Prioritizing Closest Exams, Course Difficulty, and Low Grasp)
    private async Task GenerateExamRevisionSchedule()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        foreach (var c in courses)
        {
            var match = await db.SemesterCourses.FindAsync(c.Id);
            if (match != null)
            {
                match.ExamDate = c.ExamDate;
            }
        }
        await db.SaveChangesAsync();

        db.StudyScheduleSlots.RemoveRange(db.StudyScheduleSlots);

        var availableWindows = freeWindows.Where(w => w.IsAvailable).ToList();
        if (!availableWindows.Any()) return;

        var prioritizedCourses = courses
            .OrderBy(c => c.ExamDate ?? DateTime.MaxValue)
            .ThenByDescending(c => c.Difficulty == "Hard" ? 3 : c.Difficulty == "Medium" ? 2 : 1)
            .ThenBy(c => c.UnderstandingPercentage)
            .ToList();

        if (!prioritizedCourses.Any()) return;

        int coursePointer = 0;
        foreach (var day in WeekDayOrder)
        {
            var window = availableWindows.FirstOrDefault(w => w.DayOfWeek == day);
            if (window == null) continue;

            var (session1Time, session2Time) = SplitWindowIntoSessions(window.TimeRange);

            var c1 = prioritizedCourses[coursePointer % prioritizedCourses.Count];
            var daysRemaining1 = (c1.ExamDate?.Date - DateTime.Today)?.Days ?? 14;
            var slidesLeft1 = Math.Max(1, c1.TotalSlides - c1.CoveredSlides);
            var dailyTarget1 = Math.Max(1, (int)Math.Ceiling((double)slidesLeft1 / Math.Max(1, daysRemaining1)));

            db.StudyScheduleSlots.Add(new StudyScheduleSlot
            {
                DayOfWeek = day,
                TimeSlot = session1Time,
                CourseCode = c1.Code,
                PlannedTopic = $"Master {dailyTarget1} slides · Grasp: {c1.UnderstandingPercentage}% (Exam in {daysRemaining1}d)",
                Reason = $"Urgent Exam Revision ({c1.Difficulty})",
                IsCompleted = false
            });

            coursePointer++;
            var c2 = prioritizedCourses[coursePointer % prioritizedCourses.Count];
            var daysRemaining2 = (c2.ExamDate?.Date - DateTime.Today)?.Days ?? 14;

            db.StudyScheduleSlots.Add(new StudyScheduleSlot
            {
                DayOfWeek = day,
                TimeSlot = session2Time,
                CourseCode = c2.Code,
                PlannedTopic = $"Past questions & key formulas · Grasp: {c2.UnderstandingPercentage}%",
                Reason = "Exam Practice & Drill",
                IsCompleted = false
            });

            coursePointer++;
        }

        await db.SaveChangesAsync();
        isExamRevisionMode = true;
        showExamDatesModal = false;
        await LoadAcademicDataAsync();

        try
        {
            await JS.InvokeVoidAsync("playStudyChime");
            await JS.InvokeVoidAsync("triggerStudyAlert", "Exam Revision Schedule Generated!", "Structured Monday to Sunday exam sprints generated with recovery breaks.");
        }
        catch { }
    }

    private async Task ToggleScheduleSlot(StudyScheduleSlot slot)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.StudyScheduleSlots.FindAsync(slot.Id);
        if (match != null)
        {
            match.IsCompleted = !match.IsCompleted;
            await db.SaveChangesAsync();
        }
        await LoadAcademicDataAsync();
    }

    private async Task ClearSchedule()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        db.StudyScheduleSlots.RemoveRange(db.StudyScheduleSlots);
        await db.SaveChangesAsync();
        await LoadAcademicDataAsync();
    }

    // Audio Ambience Controller
    private async Task ToggleAmbience()
    {
        if (isAmbiencePlaying)
        {
            await StopAmbience();
        }
        else
        {
            await ChangeAmbience(activeAmbienceType);
        }
    }

    private async Task ChangeAmbience(string type)
    {
        activeAmbienceType = type;
        isAmbiencePlaying = true;
        try
        {
            await JS.InvokeVoidAsync("playAmbientSound", type);
        }
        catch { }
    }

    private async Task StopAmbience()
    {
        isAmbiencePlaying = false;
        try
        {
            await JS.InvokeVoidAsync("stopAmbientSound");
        }
        catch { }
    }

    // Slide Focus Session & Automatic 10-Minute Reminder Engine
    private void PromptStartSlide(SemesterCourse c)
    {
        if (ActiveCourseSession != null)
        {
            alertMessage = $"Focus collision: You are already studying {ActiveCourseSession.Title} (Slide {ActiveCourseSession.ActiveSlideUnderway}). Complete or cancel it first!";
            return;
        }

        selectedCourseToStart = c;
        targetSlideMinutes = 25;
        showDurationModal = true;
    }

    private async Task ConfirmStartSlideWithDuration()
    {
        if (selectedCourseToStart == null) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.SemesterCourses.FindAsync(selectedCourseToStart.Id);
        if (match != null)
        {
            match.ActiveSlideUnderway = match.CoveredSlides + 1;
            await db.SaveChangesAsync();
        }

        showDurationModal = false;
        alertMessage = null;

        initialDurationSeconds = Math.Max(1, targetSlideMinutes) * 60;
        timerSeconds = initialDurationSeconds;
        elapsedSeconds = 0;
        isBreakMode = false;
        isTimerRunning = true;
        RunTicker();

        await LoadAcademicDataAsync();
    }

    private void ResumeTimer()
    {
        isTimerRunning = true;
        RunTicker();
    }

    private void RunTicker()
    {
        focusTicker?.Dispose();
        focusTicker = new System.Threading.Timer(async _ =>
        {
            if (timerSeconds > 0)
            {
                timerSeconds--;
                elapsedSeconds++;

                // AUTOMATIC 10-MINUTE REMINDER TRIGGER (every 600 seconds)
                if (elapsedSeconds > 0 && elapsedSeconds % 600 == 0 && timerSeconds > 0)
                {
                    int minutesLeft = timerSeconds / 60;
                    int minutesElapsed = elapsedSeconds / 60;

                    await InvokeAsync(async () =>
                    {
                        try
                        {
                            await JS.InvokeVoidAsync("playStudyChime");
                            await JS.InvokeVoidAsync("triggerStudyAlert",
                                $"StudySprint Alert: 10 mins passed!",
                                $"{minutesElapsed} minutes elapsed on {ActiveCourseSession?.Title}. {minutesLeft} minutes remaining.");
                        }
                        catch { }
                    });
                }

                await InvokeAsync(StateHasChanged);
            }
            else
            {
                isTimerRunning = false;
                focusTicker?.Dispose();
                await InvokeAsync(async () =>
                {
                    try
                    {
                        await JS.InvokeVoidAsync("playStudyChime");
                        await JS.InvokeVoidAsync("triggerStudyAlert", 
                            "Session Concluded! 🎯", 
                            $"Your scheduled focus time for {ActiveCourseSession?.Title} has ended. Mark your slide done!");
                    }
                    catch { }
                    StateHasChanged();
                });
            }
        }, null, 0, 1000);
    }

    private void StopTimer()
    {
        isTimerRunning = false;
        focusTicker?.Dispose();
    }

    private async Task CompleteActiveSlide(SemesterCourse c)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.SemesterCourses.FindAsync(c.Id);
        if (match != null)
        {
            match.CoveredSlides = Math.Min(match.TotalSlides, match.CoveredSlides + 1);
            match.ActiveSlideUnderway = null;
            await db.SaveChangesAsync();
        }
        StopTimer();
        alertMessage = null;
        await LoadAcademicDataAsync();
    }

    private async Task CancelActiveSlide(SemesterCourse c)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.SemesterCourses.FindAsync(c.Id);
        if (match != null)
        {
            match.ActiveSlideUnderway = null;
            await db.SaveChangesAsync();
        }
        StopTimer();
        alertMessage = null;
        await LoadAcademicDataAsync();
    }

    private void OpenAddCourseModal()
    {
        editingCourseId = null;
        courseModel = new SemesterCourse();
        showCourseModal = true;
    }

    private void OpenEditCourseModal(SemesterCourse c)
    {
        editingCourseId = c.Id;
        courseModel = new SemesterCourse
        {
            Id = c.Id,
            Code = c.Code,
            Title = c.Title,
            CreditHours = c.CreditHours,
            TotalSlides = c.TotalSlides,
            CoveredSlides = c.CoveredSlides,
            ClassDay = c.ClassDay,
            Difficulty = c.Difficulty,
            UnderstandingPercentage = c.UnderstandingPercentage,
            TargetGrade = c.TargetGrade,
            ExamDate = c.ExamDate
        };
        showCourseModal = true;
    }

    private async Task SaveCourse()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        if (editingCourseId.HasValue)
        {
            var match = await db.SemesterCourses.FindAsync(editingCourseId.Value);
            if (match != null)
            {
                match.Code = courseModel.Code;
                match.Title = courseModel.Title;
                match.CreditHours = courseModel.CreditHours;
                match.TotalSlides = courseModel.TotalSlides;
                match.CoveredSlides = Math.Min(courseModel.CoveredSlides, courseModel.TotalSlides);
                match.ClassDay = courseModel.ClassDay;
                match.Difficulty = courseModel.Difficulty;
                match.UnderstandingPercentage = Math.Clamp(courseModel.UnderstandingPercentage, 0, 100);
                match.TargetGrade = courseModel.TargetGrade;
                match.ExamDate = courseModel.ExamDate;
                await db.SaveChangesAsync();
            }
        }
        else
        {
            courseModel.CoveredSlides = Math.Min(courseModel.CoveredSlides, courseModel.TotalSlides);
            courseModel.UnderstandingPercentage = Math.Clamp(courseModel.UnderstandingPercentage, 0, 100);
            db.SemesterCourses.Add(courseModel);
            await db.SaveChangesAsync();
        }

        showCourseModal = false;
        await LoadAcademicDataAsync();
    }

    private async Task UpdateTargetGrade(SemesterCourse c, string? newGrade)
    {
        if (string.IsNullOrWhiteSpace(newGrade)) return;
        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.SemesterCourses.FindAsync(c.Id);
        if (match != null)
        {
            match.TargetGrade = newGrade;
            await db.SaveChangesAsync();
        }
        await LoadAcademicDataAsync();
    }

    private async Task IncrementSlides(SemesterCourse c, int delta)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.SemesterCourses.FindAsync(c.Id);
        if (match != null)
        {
            match.CoveredSlides = Math.Clamp(match.CoveredSlides + delta, 0, match.TotalSlides);
            if (match.ActiveSlideUnderway.HasValue && match.CoveredSlides >= match.ActiveSlideUnderway.Value)
            {
                match.ActiveSlideUnderway = null;
            }
            await db.SaveChangesAsync();
        }
        await LoadAcademicDataAsync();
    }

    private async Task DeleteCourse(int id)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.SemesterCourses.FindAsync(id);
        if (match != null)
        {
            db.SemesterCourses.Remove(match);
            await db.SaveChangesAsync();
        }
        await LoadAcademicDataAsync();
    }

    private async Task SeedSampleAcademicData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        if (!db.SemesterCourses.Any())
        {
            db.SemesterCourses.AddRange(
                new SemesterCourse { Code = "ENGR 111", Title = "Machine Learning", CreditHours = 3, TotalSlides = 40, CoveredSlides = 10, ClassDay = "Monday", Difficulty = "Hard", UnderstandingPercentage = 35, TargetGrade = "A", ExamDate = DateTime.Today.AddDays(12) },
                new SemesterCourse { Code = "ENCE 324", Title = "Visual Programming with C#", CreditHours = 3, TotalSlides = 50, CoveredSlides = 35, ClassDay = "Wednesday", Difficulty = "Medium", UnderstandingPercentage = 75, TargetGrade = "A", ExamDate = DateTime.Today.AddDays(5) },
                new SemesterCourse { Code = "ENCE 112", Title = "Routing and Switching", CreditHours = 3, TotalSlides = 35, CoveredSlides = 15, ClassDay = "Friday", Difficulty = "Easy", UnderstandingPercentage = 80, TargetGrade = "B+", ExamDate = DateTime.Today.AddDays(18) }
            );
            await db.SaveChangesAsync();
            await LoadAcademicDataAsync();
        }
    }

    private string GetSlotBadgeClass(string reason) => reason switch
    {
        var r when r.Contains("Urgent") || r.Contains("Hard") => "bg-danger text-white",
        var r when r.Contains("Post") => "bg-info text-dark",
        var r when r.Contains("Pre") => "bg-primary text-white",
        _ => "bg-secondary text-white"
    };

    private string GetGPABadgeClass() => ProjectedGPA switch
    {
        >= 3.60 => "bg-success text-white",
        >= 3.00 => "bg-primary text-white",
        >= 2.50 => "bg-warning text-dark",
        _ => "bg-secondary text-white"
    };

    private string GetUrgencyBorder(int days) => days switch
    {
        < 3 => "border-danger",
        < 7 => "border-warning",
        _ => "border-info"
    };

    private string GetUrgencyBadge(int days) => days switch
    {
        < 3 => "bg-danger text-white",
        < 7 => "bg-warning text-dark",
        _ => "bg-info text-white"
    };

    public void Dispose()
    {
        focusTicker?.Dispose();
        _ = StopAmbience();
    }
}