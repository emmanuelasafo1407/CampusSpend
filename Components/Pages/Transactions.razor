@page "/transactions"
@rendermode InteractiveServer
@using CampusSpend.Models
@using CampusSpend.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Transactions Ledger — CampusSpend</PageTitle>

<div class="container-fluid px-4 py-4 min-vh-100 bg-light">
    
    <!-- Top Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Expense Ledger & Cash Outflows</h2>
            <small class="text-muted">Log, audit, search, and export student expenditures.</small>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button class="btn btn-outline-dark btn-sm shadow-sm" @onclick="ExportToCSV">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
            </button>
            <button class="btn btn-primary btn-sm shadow-sm" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle me-1"></i> New Expense
            </button>
        </div>
    </div>

    <!-- Exam Lockout Warning Banner -->
    @if (budgetSetting.IsCurrentlyInExamWindow)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill fs-3 text-danger"></i>
                <div>
                    <strong class="d-block">Exam Mode Financial Lockout is Active!</strong>
                    <span class="small">Non-essential 'Lifestyle' spending is <strong>completely blocked</strong> until @(budgetSetting.ExamLockoutEndDate?.ToString("dd MMM yyyy") ?? "exams end").</span>
                </div>
            </div>
            <span class="badge bg-danger text-white px-3 py-2">Hard Block Enforced</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(lockoutBlockedAlert))
    {
        <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2 text-danger"></i>
            @lockoutBlockedAlert
            <button type="button" class="btn-close" @onclick="() => lockoutBlockedAlert = null"></button>
        </div>
    }

    <!-- Filtering & Search Bar -->
    <div class="card stat-card shadow-sm border-0 p-3 bg-white mb-4">
        <div class="row g-2">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search description or category..." @bind="searchQuery" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-4">
                <select class="form-select form-select-sm" @bind="selectedCategory">
                    <option value="All">All Categories</option>
                    <option value="Food">Food</option>
                    <option value="Academics">Academics</option>
                    <option value="Transport">Transport</option>
                    <option value="Data/Airtime">Data/Airtime</option>
                    <option value="Utilities">Utilities</option>
                    <option value="Lifestyle">Lifestyle</option>
                </select>
            </div>
            <div class="col-md-3 text-md-end">
                <span class="small text-muted align-middle">Showing @FilteredExpenses.Count of @expenses.Count records</span>
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="card stat-card shadow-sm border-0 bg-white overflow-hidden">
        @if (FilteredExpenses.Count == 0)
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-receipt fs-1 d-block mb-2 text-secondary"></i>
                No expense transactions found matching your criteria.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Payment</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredExpenses)
                        {
                            <tr>
                                <td class="small text-muted">@item.DateIncurred.ToString("dd MMM yyyy")</td>
                                <td>
                                    <strong class="text-dark">@item.Description</strong>
                                </td>
                                <td>
                                    <span class="badge @GetCategoryBadge(item.Category)">@item.Category</span>
                                </td>
                                <td class="small text-muted">@item.PaymentMethod</td>
                                <td class="text-end fw-bold text-dark">GHS @item.Amount.ToString("N2")</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-link text-primary p-0 me-2 text-decoration-none" @onclick="() => OpenEditModal(item)">Edit</button>
                                    <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none" @onclick="() => DeleteExpense(item.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal: Create or Edit Expense -->
@if (showExpenseModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-3">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@(editingExpenseId.HasValue ? "Edit Expense" : "Log Expense")</h5>
                    <button type="button" class="btn-close" @onclick="() => showExpenseModal = false"></button>
                </div>
                <div class="modal-body">
                    
                    @if (budgetSetting.IsCurrentlyInExamWindow)
                    {
                        <div class="alert alert-danger p-2 small mb-3">
                            <i class="bi bi-shield-lock-fill me-1"></i>
                            <strong>Exam Lockout Active:</strong> Recreational and 'Lifestyle' transactions are blocked until exams end.
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description:</label>
                        <input type="text" class="form-control" @bind="expenseModel.Description" placeholder="e.g. Rice & Chicken or Lab Breadboard" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Amount (GHS):</label>
                            <input type="number" class="form-control" @bind="expenseModel.Amount" step="0.5" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Category:</label>
                            <select class="form-select" @bind="expenseModel.Category">
                                <option value="Food">Food</option>
                                <option value="Academics">Academics</option>
                                <option value="Transport">Transport</option>
                                <option value="Data/Airtime">Data/Airtime</option>
                                <option value="Utilities">Utilities</option>
                                @if (budgetSetting.IsCurrentlyInExamWindow)
                                {
                                    <option value="Lifestyle" disabled>🔒 Lifestyle (LOCKED FOR EXAMS)</option>
                                }
                                else
                                {
                                    <option value="Lifestyle">Lifestyle</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Payment Channel:</label>
                            <select class="form-select" @bind="expenseModel.PaymentMethod">
                                <option value="Mobile Money">Mobile Money (MoMo)</option>
                                <option value="Cash">Cash</option>
                                <option value="Bank Card">Bank Card</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Date Incurred:</label>
                            <input type="date" class="form-control" @bind="expenseModel.DateIncurred" />
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showExpenseModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveExpense">Save Transaction</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Expense> expenses = new();
    private BudgetSetting budgetSetting = new();
    private Expense expenseModel = new();
    private int? editingExpenseId = null;
    private bool showExpenseModal = false;
    private string? lockoutBlockedAlert = null;

    private string searchQuery = "";
    private string selectedCategory = "All";

    private List<Expense> FilteredExpenses => expenses
        .Where(e => (selectedCategory == "All" || e.Category == selectedCategory) &&
                    (string.IsNullOrWhiteSpace(searchQuery) || 
                     e.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
                     e.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        expenses = await db.Expenses.OrderByDescending(e => e.DateIncurred).ToListAsync();
        budgetSetting = await db.BudgetSettings.FirstOrDefaultAsync() ?? new BudgetSetting();
    }

    private void OpenCreateModal()
    {
        editingExpenseId = null;
        expenseModel = new Expense { DateIncurred = DateTime.Today, Amount = 15.00m, Category = "Food" };
        showExpenseModal = true;
    }

    private void OpenEditModal(Expense e)
    {
        editingExpenseId = e.Id;
        expenseModel = new Expense
        {
            Id = e.Id,
            Description = e.Description,
            Amount = e.Amount,
            Category = e.Category,
            PaymentMethod = e.PaymentMethod,
            DateIncurred = e.DateIncurred
        };
        showExpenseModal = true;
    }

    private async Task SaveExpense()
    {
        if (string.IsNullOrWhiteSpace(expenseModel.Description) || expenseModel.Amount <= 0) return;

        // HARD GUARD CLAUSE: Reject non-essential categories during Exam Lockout
        if (budgetSetting.IsCurrentlyInExamWindow && expenseModel.Category == "Lifestyle")
        {
            showExpenseModal = false;
            lockoutBlockedAlert = "ACTION BLOCKED: 'Lifestyle' spending is strictly prohibited while Exam Financial Lockout is active. Save your capital for exam essentials!";
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        if (editingExpenseId.HasValue)
        {
            var match = await db.Expenses.FindAsync(editingExpenseId.Value);
            if (match != null)
            {
                match.Description = expenseModel.Description;
                match.Amount = expenseModel.Amount;
                match.Category = expenseModel.Category;
                match.PaymentMethod = expenseModel.PaymentMethod;
                match.DateIncurred = expenseModel.DateIncurred;
                await db.SaveChangesAsync();
            }
        }
        else
        {
            db.Expenses.Add(expenseModel);
            await db.SaveChangesAsync();
        }

        showExpenseModal = false;
        lockoutBlockedAlert = null;
        await LoadDataAsync();
    }

    private async Task DeleteExpense(int id)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.Expenses.FindAsync(id);
        if (match != null)
        {
            db.Expenses.Remove(match);
            await db.SaveChangesAsync();
        }
        await LoadDataAsync();
    }

    private async Task ExportToCSV()
    {
        var csv = "ID,Date,Description,Category,PaymentMethod,Amount\n";
        foreach (var e in expenses)
        {
            csv += $"{e.Id},{e.DateIncurred:yyyy-MM-dd},\"{e.Description}\",{e.Category},{e.PaymentMethod},{e.Amount}\n";
        }

        var fileName = $"CampusSpend_Ledger_{DateTime.Now:yyyyMMdd}.csv";
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync("eval", $@"
            var a = document.createElement('a');
            a.href = 'data:text/csv;base64,{base64}';
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ");
    }

    private string GetCategoryBadge(string category) => category switch
    {
        "Food" => "bg-success-subtle text-success border border-success",
        "Academics" => "bg-warning-subtle text-dark border border-warning",
        "Transport" => "bg-primary-subtle text-primary border border-primary",
        "Data/Airtime" => "bg-info-subtle text-dark border border-info",
        "Utilities" => "bg-secondary-subtle text-dark border border-secondary",
        "Lifestyle" => "bg-danger-subtle text-danger border border-danger",
        _ => "bg-light text-dark border"
    };
}