@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar no-print">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center no-print">
            <span class="text-muted small fw-semibold">GCTU Engineering Workspace</span>
            <button class="btn btn-link text-decoration-none text-primary fw-bold small p-0" @onclick="() => showAboutModal = true">
                <i class="bi bi-info-circle me-1"></i> About System
            </button>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<!-- Global About System Modal -->
<AboutModal @bind-IsOpen="showAboutModal" />

@code {
    private bool showAboutModal = false;
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
